[Unit]
Description=Bees BTRFS deduplication setup
Documentation=https://github.com/Zygo/bees
# /etc is mounted by dracut pre-pivot hook before systemd starts — no etc.mount
# unit exists. Bees needs only the Btrfs filesystem, so local-fs.target suffices.
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# No ProtectSystem/ReadOnlyPaths — this writes /etc/bees/*.conf and enables a
# unit under /etc/systemd/system via `systemctl enable`; ProtectSystem=full
# or =strict would make /etc read-only and break both.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@mount @raw-io @debug @reboot
RestrictAddressFamilies=AF_UNIX
UMask=0077
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
LogLevelMax=warning
ExecStart=/usr/local/bin/beesd-setup

[Install]
WantedBy=multi-user.target
