[Unit]
Description=Update Flatpak (System)
# Runs only via flatpak-update-system.timer (OnBootSec=15min).
# After=network-online.target ensures network is routable before attempting
# Flathub metadata fetch — avoids silent failure on slow-connect boots.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@mount @raw-io @debug @reboot
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
LogLevelMax=info
# Repair + update + unused-removal can take well over the default 90s on a
# large installation; never time the unit out mid-operation.
TimeoutStartSec=0

# Repair first: a power cut or partial write during an update can leave the
# OSTree repo with dangling objects or wrong permissions. `flatpak repair`
# checks every object and fixes what it can; a failure here must not block
# the subsequent update, hence the leading '-'.
ExecStartPre=-/usr/bin/flatpak repair --system
ExecStart=/usr/bin/flatpak update --noninteractive --assumeyes --system
ExecStartPost=/usr/bin/flatpak uninstall --unused --delete-data --noninteractive --assumeyes --system

# No [Install] — activated exclusively by flatpak-update-system.timer.
# Do not enable this service directly; enable the timer instead.
