[Unit]
Description=Mark Boot In Progress for Shani OS
DefaultDependencies=no
# Requires=data.mount: if /data is not mounted we cannot write the boot marker.
# A failed write would leave boot_in_progress absent, making the 15-minute
# failure detection blind for this boot. Hard-fail the service so the condition
# failure is visible in the journal rather than silently undetected.
Requires=data.mount
After=data.mount
# Record a failure of this unit itself where shani-health will see it after
# a reboot (see shani-boot-safety-failed@.service).
OnFailure=shani-boot-safety-failed@%n.service

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=rm -f /data/boot-ok /data/boot_failure.acked /data/boot_in_progress /data/auto_rollback_done
ExecStart=touch /data/boot_in_progress
RemainAfterExit=yes

[Install]
WantedBy=local-fs.target
