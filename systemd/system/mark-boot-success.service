[Unit]
Description=Mark Boot Success for Shani OS
After=multi-user.target data.mount
Requires=data.mount
ConditionPathExists=/data/boot_in_progress
# Record a failure of this unit itself where shani-health will see it after
# a reboot (see shani-boot-safety-failed@.service).
OnFailure=shani-boot-safety-failed@%n.service

[Service]
Type=oneshot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# Mark boot successful
ExecStart=touch /data/boot-ok

# Clear in-progress marker
ExecStart=rm -f /data/boot_in_progress

# If we successfully booted the same slot that was previously marked failed,
# the failure marker is now stale and must be cleared to avoid false rollback.
# (Logic lives in a real script: inline shell in unit files breaks on
# backslash escapes — systemd silently drops "unknown escape sequences".)
ExecStart=/usr/local/bin/boot-success-cleanup

RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
