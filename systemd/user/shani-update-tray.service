[Unit]
Description=Shani OS Update Tray Icon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shani-update --tray
Environment=XDG_RUNTIME_DIR=%t
# yad --notification runs in the foreground for as long as the icon should
# exist (see _run_tray()'s own comment in scripts/shani-update.sh) — this
# is a real long-lived process, not a oneshot, unlike shani-update.service.
Restart=on-failure
RestartSec=5
# Deliberately NO NoNewPrivileges/ProtectSystem/PrivateTmp — same reasoning
# as shani-update.service: the tray's menu actions spawn ordinary
# `shani-update`/`shani-update --rollback` invocations, which re-exec via
# pkexec (setuid-root); those hardening directives are inherited across
# that boundary and would silently block the escalation.

[Install]
WantedBy=graphical-session.target
